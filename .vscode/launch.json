{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/BonProf/bin/Debug/net8.0/BonProf.dll",
      "args": [],
      "cwd": "${workspaceFolder}/BonProf",
      "stopAtEntry": false,
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/index.html"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/BonProf/Views"
      }
    },
    {
      "name": ".NET Core Launch (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/BonProf/bin/Debug/net8.0/BonProf.dll",
      "args": [],
      "cwd": "${workspaceFolder}/BonProf",
      "stopAtEntry": false,
      "launchSettingsProfile": "http",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/BonProf/Views"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
