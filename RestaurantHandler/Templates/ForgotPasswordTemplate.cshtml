@using RestaurantHandler.Models
@model ResetPasswordModel
@{
    Layout = "_EmailLayout.cshtml";
    ViewBag.Title = "Réinitialisation de votre mot de passe";
    ViewBag.Preheader = "Vous avez demandé à réinitialiser votre mot de passe BonProf. Ce lien expire dans 1 heure.";
    ViewBag.WebsiteLink = Model.WebsiteLink;
    var firstName = Model.Receiver.FirstName;
}
<h1 style="margin:0 0 16px 0; font-size:22px; line-height:1.3; font-weight:700; color:#8f2942;">Réinitialisation de votre mot de passe</h1>
<p style="margin:0 0 16px 0;">@(string.IsNullOrWhiteSpace(firstName) ? "Bonjour," : $"Bonjour {firstName},")</p>
<p style="margin:0 0 16px 0;">Nous avons reçu une demande de réinitialisation du mot de passe de votre compte BonProf. Cliquez sur le bouton ci-dessous pour en choisir un nouveau.</p>

@{ await IncludeAsync("_Button.cshtml", new EmailButton(Model.ValidationLink, "Réinitialiser mon mot de passe")); }

<p style="margin:0 0 24px 0; font-size:14px; color:#4b5563;">Pour des raisons de sécurité, ce lien expire dans <strong>1 heure</strong>.</p>

@{ await IncludeAsync("_LinkFallback.cshtml", Model.ValidationLink); }

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0;">
    <tr>
        <td style="padding:16px 20px; background-color:#fdf2f3; border-left:4px solid #8f2942; border-radius:4px; font-size:14px; line-height:1.5; color:#4b5563;">
            Vous n'êtes pas à l'origine de cette demande ? Ignorez simplement cet e-mail : votre mot de passe reste inchangé.
        </td>
    </tr>
</table>
<p style="margin:24px 0 0 0;">L'équipe BonProf</p>
