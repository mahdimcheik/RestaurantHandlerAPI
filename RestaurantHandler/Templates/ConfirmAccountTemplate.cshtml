@using RestaurantHandler.Models
@model ConfirmMailModel
@{
    Layout = "_EmailLayout.cshtml";
    ViewBag.Title = "Activez votre compte BonProf";
    ViewBag.Preheader = "Plus qu'une étape : confirmez votre adresse e-mail pour activer votre compte.";
    ViewBag.WebsiteLink = Model.WebsiteLink;
    var firstName = Model.Receiver.FirstName;
}
<h1 style="margin:0 0 16px 0; font-size:22px; line-height:1.3; font-weight:700; color:#8f2942;">Bienvenue sur BonProf !</h1>
<p style="margin:0 0 16px 0;">@(string.IsNullOrWhiteSpace(firstName) ? "Bonjour," : $"Bonjour {firstName},")</p>
<p style="margin:0 0 16px 0;">Merci pour votre inscription. Pour activer votre compte et commencer à utiliser la plateforme, il vous suffit de confirmer votre adresse e-mail.</p>

@{ await IncludeAsync("_Button.cshtml", new EmailButton(Model.ConfirmLink, "Activer mon compte")); }

<p style="margin:0 0 24px 0; font-size:14px; color:#4b5563;">Ce lien est valable <strong>7 jours</strong>.</p>

@{ await IncludeAsync("_LinkFallback.cshtml", Model.ConfirmLink); }

<p style="margin:0; font-size:14px; color:#4b5563;">Si vous n'êtes pas à l'origine de cette inscription, vous pouvez ignorer cet e-mail en toute sécurité.</p>
<p style="margin:24px 0 0 0;">À très bientôt,<br><strong>L'équipe BonProf</strong></p>
