@using RestaurantHandler.Utilities
@{
    string title = ViewBag.Title ?? HardCode.APP_NAME;
    string preheader = ViewBag.Preheader ?? "";
    string websiteLink = ViewBag.WebsiteLink ?? "";
    // ViewBag est un ExpandoObject : lire une clé absente lève une exception.
    bool allowReply = ((IDictionary<string, object>)ViewBag).TryGetValue("AllowReply", out var reply) && reply is true;
}
<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>@title</title>
    <style>
        @@media only screen and (max-width: 620px) {
            .bp-card { width: 100% !important; border-radius: 0 !important; }
            .bp-pad { padding-left: 24px !important; padding-right: 24px !important; }
        }
        a { color: #8f2942; }
    </style>
</head>
<body style="margin:0; padding:0; background-color:#f3f1f2; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
    <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#f3f1f2; opacity:0;">@preheader</div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f1f2;">
        <tr>
            <td align="center" style="padding:32px 12px;">

                <table role="presentation" class="bp-card" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:12px; border-top:4px solid #8f2942; overflow:hidden;">
                    <tr>
                        <td align="center" class="bp-pad" style="padding:32px 48px 8px 48px;">
                            <img src="cid:app-logo" width="120" alt="@HardCode.APP_NAME" style="display:block; width:120px; max-width:120px; height:auto; border:0; outline:none; text-decoration:none;">
                        </td>
                    </tr>
                    <tr>
                        <td class="bp-pad" style="padding:24px 48px 40px 48px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:16px; line-height:1.6; color:#1f2937;">
                            @RenderBody()
                        </td>
                    </tr>
                    <tr>
                        <td class="bp-pad" style="padding:24px 48px; background-color:#faf7f8; border-top:1px solid #eee5e8; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; line-height:1.6; color:#6b7280; text-align:center;">
                            <p style="margin:0 0 8px 0;"><strong style="color:#8f2942;">@HardCode.APP_NAME</strong> — commandez en ligne, retirez sur place</p>
                            @if (!string.IsNullOrWhiteSpace(websiteLink))
                            {
                                <p style="margin:0 0 8px 0;"><a href="@websiteLink" style="color:#8f2942; text-decoration:underline;">Accéder à @HardCode.APP_NAME</a></p>
                            }
                            @if (!allowReply)
                            {
                                <p style="margin:0 0 8px 0;">Cet e-mail a été envoyé automatiquement, merci de ne pas y répondre.</p>
                            }
                            <p style="margin:0; color:#9ca3af;">© @DateTime.UtcNow.Year @HardCode.APP_NAME. Tous droits réservés.</p>
                        </td>
                    </tr>
                </table>

            </td>
        </tr>
    </table>
</body>
</html>
