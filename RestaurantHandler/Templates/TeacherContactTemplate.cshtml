@using RestaurantHandler.Models
@model TeacherContactModel
@{
    Layout = "_EmailLayout.cshtml";
    ViewBag.Title = Model.Subject;
    ViewBag.Preheader = $"Nouveau message de {Model.StudentName} sur BonProf.";
    ViewBag.WebsiteLink = Model.WebsiteLink;
    var firstName = Model.Receiver.FirstName;
}
<h1 style="margin:0 0 16px 0; font-size:22px; line-height:1.3; font-weight:700; color:#8f2942;">Nouveau message d'un élève</h1>
<p style="margin:0 0 16px 0;">@(string.IsNullOrWhiteSpace(firstName) ? "Bonjour," : $"Bonjour {firstName},")</p>
<p style="margin:0 0 24px 0;"><strong>@Model.StudentName</strong> vous a envoyé un message via BonProf.</p>

<p style="margin:0 0 8px 0; font-size:13px; text-transform:uppercase; letter-spacing:0.05em; color:#6b7280;">Objet : <span style="text-transform:none; letter-spacing:0; color:#1f2937; font-weight:600;">@Model.Subject</span></p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
    <tr>
        <td style="padding:20px 24px; background-color:#fdf2f3; border-left:4px solid #8f2942; border-radius:4px; font-size:15px; line-height:1.6; color:#1f2937;">
            @Raw(Model.MessageHtml)
        </td>
    </tr>
</table>

<p style="margin:0 0 8px 0;">Pour lui répondre, écrivez-lui directement à l'adresse suivante :</p>
<p style="margin:0;"><a href="mailto:@Model.StudentEmail" style="color:#8f2942; font-weight:600;">@Model.StudentEmail</a></p>
