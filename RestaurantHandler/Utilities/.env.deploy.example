# Modèle du .env de PRODUCTION, à copier sur Acer dans ~/restauranthandler/back-end à côté de
# docker-compose.yml (le .env.example du projet reste le modèle du dev local) :
#   cp .env.deploy.example .env && chmod 600 .env && vi .env
# Ce fichier est lu par le compose (POSTGRES_*, IMAGE_TAG) ET passé tel quel à l'API (env_file).
# Remplacer DOMAINE par le domaine public (un seul domaine : le front relaie /api et /hubs).

# --- Version déployée ---
# Réécrite par le workflow CI-CD à chaque tag. Retour arrière : remettre l'ancien tag puis
# `docker compose up -d api`.
IMAGE_TAG=latest

ASPNETCORE_ENVIRONMENT=Production

# --- Postgres (service `db`) ---
# POSTGRES_* créent le rôle et la base au premier démarrage, DB_* sont lus par l'API :
# garder les deux jeux cohérents. Mot de passe : openssl rand -hex 24
POSTGRES_USER=restauranthandler
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=restauranthandler
# Port publié sur 127.0.0.1 seulement (5431 est pris sur Acer).
POSTGRES_PORT=5435

DB_HOST=db
DB_PORT=5432
DB_NAME=restauranthandler
DB_USER=restauranthandler
DB_PASSWORD=replace-me

# --- URLs ---
# API_BACK_URL porte le préfixe /api (retiré par le nginx du front) : liens de confirmation
# d'e-mail, émetteur JWT et URL de notification SumUp ({API_BACK_URL}/payments/sumup/notifications).
API_FRONT_URL=https://DOMAINE
API_BACK_URL=https://DOMAINE/api

# --- Auth ---
# Au moins 32 caractères : openssl rand -base64 48
JWT_KEY=replace-me
TOKEN_VALIDITY_MINUTES=30
COOKIES_VALIDITY_DAYS=7
COOKIES_SECURE=true
GOOGLE_CLIENT_ID=

# Manager initial créé au démarrage s'il n'existe pas (AdminAccountsSeeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- SumUp (paiement en ligne). Vide = paiement en ligne désactivé ---
SUMUP_API_URL=https://api.sumup.com
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# --- Mail (SMTP) ---
SMTP_HOST=
SMTP_LOGIN=
SMTP_KEY=
SMTP_PORT=587
SMTP_ALLOW_SELF_SIGNED=false
DO_NO_REPLY_MAIL=

# --- Stockage des fichiers (ADR-0003) ---
# local = disque de l'API (volume « uploads » du docker-compose), servi sous {API_BACK_URL}/uploads ;
# s3 = OVH Object Storage, variables S3_* ci-dessous (ignorées en local).
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=
STORAGE_PUBLIC_URL=
S3_UPLOAD_URL=https://s3.gra.io.cloud.ovh.net
S3_PUBLIC_URL=https://restauranthandler.s3.gra.io.cloud.ovh.net
S3_BUCKET=restauranthandler
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif,.pdf,.docx,.xlsx,.csv,.txt,.mp4
SIGNED_URL_MINUTES=60
PRIVACY_DOCUMENT_RETENTION_DAYS=30

# --- Rate limiting ---
# L'IP du client arrive par X-Forwarded-For (NPM → nginx du front, qui le transmet sans
# l'allonger). Les adresses privées ne sont jamais limitées.
RATE_LIMITING_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=300
RATE_LIMIT_USER_PER_MINUTE=200
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EXEMPT_IPS=

# --- Web Push (dormant en V1), vide = désactivé ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@DOMAINE

# --- Diagnostic : jamais activés en production ---
LOG_SQL=false
HANGFIRE_DASHBOARD_ALLOW_LOCAL=false
