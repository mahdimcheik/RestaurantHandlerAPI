# Template for RestaurantHandler/.env — copy to .env and fill in real values.
# .env is loaded locally only (via DotNetEnv in Program.cs); it is never used in
# production/Docker, where real environment variables are set instead.

ASPNETCORE_ENVIRONMENT=Development

# auth
JWT_KEY=
API_FRONT_URL=https://localhost:4201
# Dashboard Hangfire sans session depuis cette machine (Development uniquement)
HANGFIRE_DASHBOARD_ALLOW_LOCAL=false
# Journalise le SQL d'EF Core (diagnostic de performance, jamais en production)
LOG_SQL=false
API_BACK_URL=https://localhost:7113
COOKIES_VALIDITY_DAYS=7
# false seulement en dev local sans HTTPS
COOKIES_SECURE=true
TOKEN_VALIDITY_MINUTES=30

# database
DB_PORT=5432
DB_HOST=localhost
DB_NAME=restauranthandler
DB_USER=postgres
DB_PASSWORD=

# Manager initial créé au démarrage s'il n'existe pas
ADMIN_EMAIL=manager@example.com
ADMIN_PASSWORD=

# mail (SMTP)
SMTP_HOST=
SMTP_LOGIN=
SMTP_KEY=
SMTP_PORT=587
# true seulement pour un SMTP interne à certificat auto-signé (Stalwart)
SMTP_ALLOW_SELF_SIGNED=false
DO_NO_REPLY_MAIL=ne-pas-repondre@example.com



# google
# Client id OAuth "application web" : audience attendue par POST /auth/google lors de la
# validation de l'ID token. Doit être identique à celui utilisé par le front.
GOOGLE_CLIENT_ID=

# notifications natives (Web Push / VAPID) — dormant en V1 (prévu en V2), vide = désactivé.
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# rate limiting (Infrastructure/RateLimiting/RateLimitingSetup.cs) — 429 au-delà.
# Les adresses privées / de bouclage ne sont jamais limitées : le reverse proxy DOIT transmettre
# X-Forwarded-For, sinon toutes les requêtes semblent venir du proxy et rien n'est limité.
RATE_LIMITING_ENABLED=true
# requêtes par minute et par IP, toutes routes (large : un réseau mobile ou un foyer partage une IP)
RATE_LIMIT_IP_PER_MINUTE=300
# requêtes par minute et par utilisateur connecté, quelle que soit son IP
RATE_LIMIT_USER_PER_MINUTE=200
# tentatives par minute et par IP sur connexion, inscription, Google, mot de passe oublié…
RATE_LIMIT_AUTH_PER_MINUTE=10
# IP publiques jamais limitées, séparées par des virgules : mettre celle du serveur front (SSR),
# qui appelle l'API pour tous ses visiteurs depuis une seule adresse.
RATE_LIMIT_EXEMPT_IPS=


# Stockage objet (StorageService, ADR-0003) — OVH Object Storage, un compartiment : avatars/ envoyés
# en public-read et lus via S3_PUBLIC_URL, le reste par lien signé (lié à l'hôte de S3_UPLOAD_URL).
# La région de signature est déduite de S3_UPLOAD_URL (s3.gra.io.cloud.ovh.net → gra).
# Clés S3 d'un utilisateur Object Storage dédié, jamais celles du compte admin.
S3_UPLOAD_URL=https://s3.gra.io.cloud.ovh.net
S3_PUBLIC_URL=https://restauranthandler.s3.gra.io.cloud.ovh.net
S3_BUCKET=restauranthandler
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif,.pdf,.docx,.xlsx,.csv,.txt,.mp4
SIGNED_URL_MINUTES=60
PRIVACY_DOCUMENT_RETENTION_DAYS=30
